APP_NAME="PC Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# 会员认证网关域名，不包含 /api-iam，例如 https://gateway.example.com
MEMBER_AUTH_BASE_URL=
MEMBER_AUTH_GATEWAY_PREFIX=api-iam
MEMBER_AUTH_API_PREFIX=api/v1
MEMBER_AUTH_CONNECT_TIMEOUT_SECONDS=3
MEMBER_AUTH_TIMEOUT_SECONDS=10
MEMBER_AUTH_TOKEN_TTL_SECONDS=172800

COMMISSION_MONTHLY_BASE=100000
COMMISSION_ACTUAL_ARCHITECTURE_AMOUNT=3000000
COMMISSION_UPLOAD_CHANGES=0
PC_MANAGEMENT_HTTP_PORT=8081
# 生产镜像协议：测试填 http，生产填 https
NGINX_PROTOCOL=https
# 生产镜像 HTTPS 宿主机端口
PC_MANAGEMENT_HTTPS_PORT=8443
# 生产 Nginx 容器内证书路径（宿主机 /etc/nginx/ssl 只读挂载）
NGINX_SSL_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/ssl/privkey.pem
COMMISSION_STATISTICS_TIMEZONE=Asia/Shanghai
COMMISSION_DAILY_SCHEDULE_TIME=00:05
COMMISSION_WEEKLY_SCHEDULE_TIME=00:15
COMMISSION_QUARTERLY_SCHEDULE_TIME=00:25
COMMISSION_SLOW_QUERY_MS=1000
COMMISSION_PARALLEL_RESULT_TTL_SECONDS=86400
COMMISSION_PARALLEL_JOB_TIMEOUT_SECONDS=7200
COMMISSION_QUEUE_RETRY_AFTER=7260
COMMISSION_WORKERS=5
COMMISSION_WORKER_CONNECTION=commission
COMMISSION_WORKER_QUEUE=commission
COMMISSION_WORKER_TRIES=3
COMMISSION_WORKER_TIMEOUT=7200
COMMISSION_QUEUE_BLOCK_FOR=5
QUEUE_FAILED_DRIVER=null
# 会员分红看板口令（当前直接读取明文变量；哈希变量仅兼容旧配置）
MEMBER_DIVIDEND_VIEW_PASSCODE=
MEMBER_DIVIDEND_VIEW_PASSCODE_HASH=
MEMBER_DIVIDEND_VIEW_SESSION_MINUTES=120
# 解锁后浏览器免口令天数（0 表示仅会话级授权）
MEMBER_DIVIDEND_VIEW_REMEMBER_DAYS=30
MEMBER_DIVIDEND_VIEW_UNLOCK_MAX_ATTEMPTS=5
MEMBER_DIVIDEND_VIEW_SQL_LOG=true
ASSET_CENTER_MAX_ATTEMPTS=5
ASSET_CENTER_RETRY_DELAY_SECONDS=300
ASSET_CENTER_PROCESSING_TIMEOUT_SECONDS=300
ASSET_CENTER_JSONLIST_ENABLED=false
ASSET_CENTER_JSONLIST_FILE_NAME=
# 首次执行 KmAuthSeeder 前由部署环境注入，不得提交真实值
KM_ADMIN_INITIAL_PASSWORD=

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_VIEWER_ENABLED=false
LOG_VIEWER_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=pc_management
DB_USERNAME=root
DB_PASSWORD=

# 第二数据库连接（业务代码固定使用 data_bridge 连接名）
DATA_BRIDGE_DB_CONNECTION=mysql
DATA_BRIDGE_DB_HOST=host.docker.internal
DATA_BRIDGE_DB_PORT=3306
DATA_BRIDGE_DB_DATABASE=data_bridge
DATA_BRIDGE_DB_USERNAME=root
DATA_BRIDGE_DB_PASSWORD=
DATA_BRIDGE_DB_PREFIX=db_

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=
# CacheManager 命名空间/版本；多环境共用 Redis 时请为每个环境设置不同 namespace
CACHE_REDIS_CONNECTION=cache
CACHE_NAMESPACE=pc-management-local
CACHE_VERSION=v1
# CACHE_HASH_KEY=             # 留空时使用 APP_KEY；轮换后旧缓存会自然 miss

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 阿里云 OSS 文件下载；允许的文件域名使用英文逗号分隔
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_URL=
OSS_SECURITY_TOKEN=
OSS_IS_CNAME=false
OSS_SHARED_SECRET=
OSS_MAX_READ_BYTES=2097152
OSS_ALLOWED_FILE_HOSTS=

# 外部文件处理服务；回调地址基于 APP_URL 自动生成
EXTERNAL_FILE_PROCESSOR_URL=
EXTERNAL_FILE_PROCESSOR_TOKEN=
EXTERNAL_FILE_PROCESSOR_TIMEOUT=10
EXTERNAL_FILE_PROCESSOR_TASK_ID_PATH=task_id
EXTERNAL_FILE_SUBMISSION_LEASE_SECONDS=60
EXTERNAL_FILE_PROCESSING_LEASE_SECONDS=300
